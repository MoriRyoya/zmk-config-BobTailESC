#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &roba_physical_layout;
    };
    
    roba_physical_layout: roba_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "BobTailESC";
        transform = <&default_transform>;
        kscan = <&kscan0>;





        /* config/BobTail.json と同じ順序・座標。15 はエンコーダ空席。
           row/col の実配線 (default_transform) とは独立した表示情報。 */
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   45       0     0     0>
            , <&key_physical_attrs 100 100  100   20       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   18       0     0     0>
            , <&key_physical_attrs 100 100  400   33       0     0     0>
            , <&key_physical_attrs 100 100  850   33       0     0     0>
            , <&key_physical_attrs 100 100  950   18       0     0     0>
            , <&key_physical_attrs 100 100 1050    0       0     0     0>
            , <&key_physical_attrs 100 100 1150   18       0     0     0>
            , <&key_physical_attrs 100 100 1250   45       0     0     0>
            , <&key_physical_attrs 100 100    0  145       0     0     0>
            , <&key_physical_attrs 100 100  100  120       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  118       0     0     0>
            , <&key_physical_attrs 100 100  400  133       0     0     0>
            , <&key_physical_attrs 100 100  500  152       0     0     0>
            , <&key_physical_attrs 100 100  750  155       0     0     0>
            , <&key_physical_attrs 100 100  850  133       0     0     0>
            , <&key_physical_attrs 100 100  950  118       0     0     0>
            , <&key_physical_attrs 100 100 1050  100       0     0     0>
            , <&key_physical_attrs 100 100 1150  118       0     0     0>
            , <&key_physical_attrs 100 100 1250  145       0     0     0>
            , <&key_physical_attrs 100 100    0  245       0     0     0>
            , <&key_physical_attrs 100 100  100  220       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  218       0     0     0>
            , <&key_physical_attrs 100 100  400  233       0     0     0>
            , <&key_physical_attrs 100 100  500  255       0     0     0>
            , <&key_physical_attrs 100 100  750  255       0     0     0>
            , <&key_physical_attrs 100 100  850  233       0     0     0>
            , <&key_physical_attrs 100 100  950  218       0     0     0>
            , <&key_physical_attrs 100 100 1050  200       0     0     0>
            , <&key_physical_attrs 100 100 1150  218       0     0     0>
            , <&key_physical_attrs 100 100 1250  245       0     0     0>
            , <&key_physical_attrs 100 100    0  345       0     0     0>
            , <&key_physical_attrs 100 100  100  320       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  318       0     0     0>
            , <&key_physical_attrs 100 100  400  343       0     0     0>
            , <&key_physical_attrs 100 100  500  378       0     0     0>
            , <&key_physical_attrs 100 100  750  368       0     0     0>
            , <&key_physical_attrs 100 100  850  340       0     0     0>
            , <&key_physical_attrs 100 100 1250  345       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;               
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(3,6) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(3,7) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,8) RC(3,9)                         RC(3,10)         
        >;
    };
    
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
            row-gpios
                = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 			
                ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <10>;
    };

    



};
